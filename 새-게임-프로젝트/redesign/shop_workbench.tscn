[gd_scene load_steps=5 format=3]

[ext_resource type="Font" path="res://redesign/combat_pixel_font.tres" id="1"]
[ext_resource type="PackedScene" path="res://redesign/shop_offer.tscn" id="2"]
[ext_resource type="Script" path="res://redesign/part_card_view.gd" id="3"]
[sub_resource type="Theme" id="Theme"]
default_font = ExtResource("1")
default_font_size = 18

[node name="ShopWorkbench" type="VBoxContainer"]
theme = SubResource("Theme")
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 12

[node name="TopActions" type="HFlowContainer" parent="."]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 10

[node name="CurrentBuildPanel" type="PanelContainer" parent="."]
visible = false
unique_name_in_owner = true
layout_mode = 2

[node name="CurrentBuildStrip" type="VBoxContainer" parent="CurrentBuildPanel"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 8

[node name="BuildHeadingRow" type="HFlowContainer" parent="CurrentBuildPanel/CurrentBuildStrip"]
layout_mode = 2
theme_override_constants/h_separation = 16
theme_override_constants/v_separation = 4

[node name="BuildHeading" type="Label" parent="CurrentBuildPanel/CurrentBuildStrip/BuildHeadingRow"]
layout_mode = 2
theme_override_colors/font_color = Color(0.662745, 0.87451, 0.74902, 1)
theme_override_font_sizes/font_size = 20
text = "현재 빌드"

[node name="BuildStatus" type="Label" parent="CurrentBuildPanel/CurrentBuildStrip/BuildHeadingRow"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 17
text = "0 / 5 장착"

[node name="WeaponStatus" type="Label" parent="CurrentBuildPanel/CurrentBuildStrip/BuildHeadingRow"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.643137, 0.705882, 0.729412, 1)
theme_override_font_sizes/font_size = 16
text = "무기 · 탄창 · 재장전"

[node name="DeckStatus" type="Label" parent="CurrentBuildPanel/CurrentBuildStrip/BuildHeadingRow"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_colors/font_color = Color(0.643137, 0.705882, 0.729412, 1)
theme_override_font_sizes/font_size = 16
text = "덱 요약"
horizontal_alignment = 2

[node name="EquippedStripHost" type="VBoxContainer" parent="CurrentBuildPanel/CurrentBuildStrip"]
unique_name_in_owner = true
layout_mode = 2

[node name="OffersHeader" type="HBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/h_separation = 14

[node name="OffersHeading" type="Label" parent="OffersHeader"]
layout_mode = 2
theme_override_colors/font_color = Color(0.662745, 0.87451, 0.74902, 1)
theme_override_font_sizes/font_size = 24
text = "오늘의 물건"

[node name="Space" type="Control" parent="OffersHeader"]
layout_mode = 2
size_flags_horizontal = 3
mouse_filter = 2

[node name="WalletStatus" type="Label" parent="OffersHeader"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.662745, 0.87451, 0.74902, 1)
theme_override_font_sizes/font_size = 20
text = "0 Cr"
horizontal_alignment = 2

[node name="OfferWorkspace" type="HBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 10

[node name="ShopOfferGrid" type="GridContainer" parent="OfferWorkspace"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
size_flags_stretch_ratio = 2.25
columns = 3
theme_override_constants/h_separation = 10
theme_override_constants/v_separation = 10

[node name="AmmoPreview" parent="OfferWorkspace/ShopOfferGrid" instance=ExtResource("2")]

[node name="CardInfo" parent="OfferWorkspace/ShopOfferGrid/AmmoPreview/Item" index="0"]
ammo_id = "charge"

[node name="PartPreview" parent="OfferWorkspace/ShopOfferGrid" instance=ExtResource("2")]

[node name="CardInfo" parent="OfferWorkspace/ShopOfferGrid/PartPreview/Item" index="0"]
script = ExtResource("3")
part_id = "field_press"
portrait = true

[node name="CorePreview" parent="OfferWorkspace/ShopOfferGrid" instance=ExtResource("2")]

[node name="CardInfo" parent="OfferWorkspace/ShopOfferGrid/CorePreview/Item" index="0"]
script = ExtResource("3")
part_id = "thermal_drive"
portrait = true

[node name="OfferComparePanel" type="PanelContainer" parent="OfferWorkspace"]
unique_name_in_owner = true
layout_mode = 2
