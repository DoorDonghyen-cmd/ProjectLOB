static func data() -> Dictionary:
	return REGISTRATION

static func pose(species: String, frame: int = 0) -> Dictionary:
	var spec: Dictionary = data()[species]
	var entry: Dictionary = spec.poses[clampi(frame,0,spec.poses.size()-1)]
	var path := str(entry.file)
	var uv := PackedVector2Array()
	for i in range(0,entry.uv.size(),2): uv.append(Vector2(entry.uv[i],entry.uv[i+1]))
	return {"texture":TEXTURES[path],"uv":uv,"source":Rect2(entry.source[0],entry.source[1],entry.source[2],entry.source[3]),"anchor":Vector2(entry.feet[0],entry.feet[1]),"scale":float(entry.scale),"height":float(spec.height)}

static func radius(species: String) -> float:
	var result := 0.0
	for entry in data()[species].poses:
		result = maxf(result,maxf(float(entry.feet[0])-float(entry.source[0]),float(entry.source[0])+float(entry.source[2])-float(entry.feet[0]))*float(entry.scale))
	return ceilf(result)
