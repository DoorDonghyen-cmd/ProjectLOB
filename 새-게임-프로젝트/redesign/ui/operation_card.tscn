[gd_scene format=3]

[ext_resource type="Theme" path="res://redesign/ui/standard_theme.tres" id="theme"]
[ext_resource type="PackedScene" path="res://redesign/ui/action_button.tscn" id="action"]

[node name="OperationCard" type="PanelContainer"]
custom_minimum_size = Vector2(0, 124)
size_flags_horizontal = 3
theme = ExtResource("theme")
theme_type_variation = &"QuietPanel"
texture_filter = 1
mouse_filter = 2

[node name="Content" type="VBoxContainer" parent="."]
layout_mode = 2
theme_type_variation = &"OperationContent"
mouse_filter = 2

[node name="Title" type="Label" parent="Content"]
layout_mode = 2
theme_type_variation = &"SectionTitle"
text = "탄환 압축"
mouse_filter = 2

[node name="Description" type="Label" parent="Content"]
layout_mode = 2
size_flags_vertical = 3
theme_type_variation = &"Caption"
text = "동일 성능 일반 2장 → 고급 1장"
autowrap_mode = 2
mouse_filter = 2

[node name="Actions" type="HBoxContainer" parent="Content"]
layout_mode = 2
mouse_filter = 2

[node name="Space" type="Control" parent="Content/Actions"]
layout_mode = 2
size_flags_horizontal = 3
mouse_filter = 2

[node name="Action" parent="Content/Actions" instance=ExtResource("action")]
layout_mode = 2

