extends "res://tests/campaign_magazine_ui.gd"

func select_one() -> void:
	var hud = host.campaign_hud
	hud.node("MagazineHousing").scroll_horizontal = 0; await settle()
	var card: Control = hud.node("Select0")
	var point: Vector2 = card.get_global_transform_with_canvas() * (card.size * 0.5)
	var press := InputEventScreenTouch.new(); press.index = 0; press.position = point; press.pressed = true
	root.push_input(press,true); await process_frame
	for position in [point+Vector2(16,0),point]:
		var drag := InputEventScreenDrag.new(); drag.index = 0; drag.position = position; drag.relative = Vector2(16,0)
		root.push_input(drag,true); await process_frame
	press = InputEventScreenTouch.new(); press.index = 0; press.position = point; press.pressed = false
	root.push_input(press,true); await settle()
	check(hud.current_budget() == 1,"public drag selects one round")

func run() -> void:
	output = OS.get_environment("QA_OUTPUT_DIR"); Input.emulate_mouse_from_touch = true
	if not output.replace("\\", "/").contains("/qa_runtime/leader_patterns_20261106/"): quit(2); return
	var file: String = ProjectSettings.globalize_path("res://../qa_runtime/leader_patterns_20261106/single_safe/combat_single_17_r2_n10902.json")
	var source: Dictionary = JSON.parse_string(FileAccess.get_file_as_string(file))
	for extent in [Vector2i(1280,800), Vector2i(1008,454), Vector2i(2340,1080)]:
		root.size = extent; root.content_scale_factor = 1; root.content_scale_size = Vector2i.ZERO
		var c = Campaign.new(); check(c.restore_state(source),"actual earned new-pattern boss state restores")
		await mount(c); hud_bounds()
		check(c.model.s.enemies[0].foundry_version == 3,"earned encounter was generated by the new campaign path")
		await capture("closed_%dx%d" % [extent.x,extent.y])
		await select_one()
		var oracle = Model.new(); oracle.s = c.model.s.duplicate(true)
		check(oracle.fire(),"oracle accepts the same prepared shot")
		await tap("Fire")
		check(canonical(c.model.s) == canonical(oracle.s),"public shot matches full resolver state/RNG")
		check(c.model.s.enemies[0].windup == 1 and not c.model.s.enemies[0].recovering,"one shot leaves a public windup warning")
		await capture("windup_%dx%d" % [extent.x,extent.y])
		oracle.s = c.model.s.duplicate(true); check(oracle.cool_magazine(),"cooling legally advances to rush")
		await tap("Cool")
		check(canonical(c.model.s) == canonical(oracle.s),"public cooling resolves the same rush/window")
		check(c.model.s.enemies[0].recovering and c.model.s.enemies[0].def == 0,"armor opens after actual public input")
		check(host.campaign_hud.board.enemies[0].def == 0 and host.campaign_hud.board.challenge_intent(0).contains("장갑 개방"),"native board renders the actual exposure state")
		await capture("open_%dx%d" % [extent.x,extent.y])
		var resumed = Campaign.new(); check(resumed.restore(),"open window autosaves")
		check(canonical(resumed.model.s) == canonical(c.model.s),"mid-window save retains exact piles/armor/RNG")
		await tap("enemy_info_0")
		check(host.campaign_hud.node("DetailBody").text.contains("파쇄로 깎은 장갑은 복구되지 않습니다"),"public enemy detail explains permanent shatter")
		await capture("detail_%dx%d" % [extent.x,extent.y])
		await tap("CloseDetail")
		await select_one(); oracle.s = c.model.s.duplicate(true); check(oracle.fire(),"counterattack remains legal")
		await tap("Fire")
		check(canonical(c.model.s) == canonical(oracle.s),"public counterattack matches actual resolver")
		check(c.model.s.enemies[0].def == c.model.s.enemies[0].shell_armor and not c.model.s.enemies[0].recovering,"recovery ends and remaining armor closes")
		await capture("countered_%dx%d" % [extent.x,extent.y])
	if is_instance_valid(host): host.free()
	FileAccess.open(output.path_join("ui.json"),FileAccess.WRITE).store_string(JSON.stringify({"checks":checks,"failures":failures},"  "))
	print("LEADER PATTERNS COMPLETE checks=%d failures=%d" % [checks,failures.size()]); quit(0 if failures.is_empty() else 1)
