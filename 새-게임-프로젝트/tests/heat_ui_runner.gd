extends "res://tests/ammo_expansion_ui_runner.gd"

func _run() -> void:
	if not ProjectSettings.globalize_path("user://").replace("\\", "/").contains("/qa_runtime/heat/"):
		quit(1)
		return
	screen = load("res://redesign/main.tscn").instantiate()
	screen.save_enabled = false
	screen.presentation_speed = 0.02
	root.add_child(screen)
	await settle()
	for resolution in [Vector2i(1280, 900), Vector2i(1008, 630), Vector2i(1440, 630)]:
		root.size = resolution
		await settle()
		await combat(["charge_hot", "precise", "pierce", "cool", "bypass"], "single", true)
		fit()
		var gauge := screen.find_child("HeatGauge", true, false)
		check(gauge != null and gauge.is_visible_in_tree() and gauge.current == 0 and gauge.limit == 12, "idle heat gauge is visible")
		check(Rect2(Vector2.ZERO, screen.size).encloses(gauge.get_global_rect()), "heat gauge bounds")
		for id in Ammo.loading_order(["charge_hot", "precise", "pierce", "cool"]): await tap("load_" + id)
		gauge = screen.find_child("HeatGauge", true, false)
		check(gauge.prediction.peak_max == 12 and gauge.prediction.end_max == 0, "preview shows peak even after automatic cooling")
		check(screen.full_forecast.shots.size() == 3 and screen.preview_label.text.contains("과열"), "public warning matches halted fourth round")
		screen.magazine_view.slot_pressed.emit(3)
		await tap("inspect_slots")
		check(screen.calculation_label.text.contains("과열되어"), "unfired cold round inspection explains thermal stop")
		screen.find_child("SlotDetails", true, false).get_meta("dialog").queue_free()
		await settle()
		fit()
		await capture("heat_stop_%d" % resolution.x)
		await tap("confirm")
		await capture("heat_ready_%d" % resolution.x)
		await tap("fire")
		check(screen.model.s.phase == "plan" and screen.model.s.turns == 3, "public fire includes compulsory reload")
		check(screen.model.s.heat == 0 and screen.find_child("HeatGauge", true, false).current == 0, "gauge settles to actual temperature")
		check(screen.last_presentation.shown_enemies == screen.model.s.enemies, "forced reload presentation exact final enemies")
		check(screen.battle_view.projectiles == screen.model.s.projectiles, "forced reload presentation exact projectiles")
		check(screen.last_presentation.events.any(func(e): return e.kind == "cooling_turn"), "extra cooling turn is visibly replayed")
		await capture("heat_cooled_%d" % resolution.x)
		await combat(["charge_hot", "precise", "pierce", "cool", "bypass"])
		for id in Ammo.loading_order(["charge_hot", "precise", "cool", "pierce"]): await tap("load_" + id)
		check(screen.full_forecast.shots.size() == 4 and screen.full_forecast.heat.forced_probability == 0, "reordering preserves four-shot chain")
		await capture("heat_safe_%d" % resolution.x)
		await tap("confirm")
		await tap("fire")
		check(screen.model.s.phase == "ready" and screen.model.s.heat == 9, "safe heat remains after firing")
		check(screen.find_child("HeatGauge", true, false).current == 9, "live gauge retains heat between actions")
		await tap("reload")
		check(screen.model.s.turns == 2 and screen.model.s.heat == 1, "manual reload is faster and carries one heat")
	for gun in Ammo.GUNS:
		await combat(["charge_hot", "precise", "pierce", "cool", "bypass"], gun)
		check(screen.find_child("HeatGauge", true, false).limit == Ammo.GUNS[gun].heat_limit, "weapon changes gauge capacity " + gun)
	await combat(["charge_hot", "precise", "arc", "precise", "cool"], "scatter")
	for key in ["load_cool", "load_precise_2", "load_arc", "load_precise", "load_charge_hot"]: await tap(key)
	check(screen.full_forecast.random and screen.full_forecast.heat.peak_max == 16, "scatter predicts thermal stop")
	screen.magazine_view.slot_pressed.emit(4)
	check(screen.calculation_label.text.contains("과열되어"), "scatter unfired round uses same thermal reason")
	await capture("heat_scatter")
	await tap("confirm")
	await tap("fire")
	check(screen.last_presentation.shown_enemies == screen.model.s.enemies, "scatter presentation exact after forced reload")
	print("HEAT UI COMPLETE checks=%d failures=%d" % [checks, failures])
	quit(0 if failures == 0 else 1)
