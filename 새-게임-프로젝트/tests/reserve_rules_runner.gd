extends "res://tests/heat_rules_runner.gd"

func saved(m: RefCounted, label: String) -> void:
	var copy = Model.new()
	check(copy.restore_state(JSON.parse_string(JSON.stringify(m.s))), label+" restores")
	check(JSON.parse_string(JSON.stringify(copy.s)) == JSON.parse_string(JSON.stringify(m.s)),label+" preserves all zones")

func finite(ids: Array, rows: Array = [], gun: String = "single") -> RefCounted:
	var m = fixture(ids,rows,gun)
	m.s.reserve_version = 1
	return m

func _run() -> void:
	if not ProjectSettings.globalize_path("user://").replace("\\","/").contains("/qa_runtime/reserve/"): quit(1);return
	for gun in Ammo.GUNS:
		for outfit in Ammo.OUTFITS:
			var c = Campaign.new()
			c.start(gun,731042,0,"balanced",3,outfit)
			check(c.model.s.deck.size()==20 and c.model.deck_limit()==Model.Reserve.CARRY_LIMITS[outfit],"finite stock and outfit carry cap")
			check(c.model.s.hand.size()==Ammo.hand_capacity(c.model.s),"outfit controls hand only")
			check(c.model.s.deck.all(func(id):return Ammo.source_id(id)=="basic"),"special ammunition earned")
			saved(c.model,"new run "+gun+" "+outfit)
			check(c.save()==OK,"campaign saves")
			var restored = Campaign.new()
			check(restored.restore(),"new campaign restores")
			check(restored.model.s.reserve_version==1 and restored.model.s.deck==c.model.s.deck,"campaign keeps finite policy")
	var m = finite(["bore","cool","basic_p1"])
	check(m.load_round("bore"),"insert unconfirmed round")
	var before: Dictionary = m.s.duplicate(true)
	check(not m.undo() and not m.remove_planned(0),"individual recall unavailable before confirmation")
	check(JSON.stringify(m.s)==JSON.stringify(before),"blocked recall leaves all zones, turns, heat, RNG and history intact")
	check(not m.load_round("bore"),"inserted copy cannot be inserted twice")
	saved(m,"locked unconfirmed round")
	m=finite(["bore","cool","basic_p1"])
	check(m.load_round("bore") and m.confirm(),"commit")
	check(m.reload_magazine(),"eject committed round")
	check(m.s.discard==["bore"] and m.s.hand.has("cool") and m.s.hand.has("basic_p1") and not m.s.hand.has("bore"),"ejection consumes round but preserves unspent hand")
	saved(m,"committed ejection")
	m = finite(["bore","cool"])
	m.s.draw.clear()
	m.s.discard=m.s.deck.duplicate()
	for id in m.s.hand: m.s.discard.erase(id)
	check(not m.exchange("cool"),"cannot exchange used pile into new ammo")
	check(m.reload_magazine() and m.s.hand==["bore","cool"],"empty draw does not shuffle used")
	check(m.s.discard.size()==8,"used pile unchanged")
	m.s.prepared=["pierce"]
	check(m.reload_magazine() and not m.s.hand.has("pierce"),"reservation cannot resurrect fired ammunition")
	saved(m,"empty reserve")
	m=finite(["basic_p1","cool"])
	check(m.exchange("basic_p1") and m.s.discard==["basic_p1"] and m.s.hand.has("cool"),"exchange spends exactly one and keeps other hand")
	saved(m,"exchange")
	m=finite(["bore","bore"])
	var charges: int=m.s.field_compression_left
	check(m.field_compress("bore"),"insert temporary compression")
	before=m.s.duplicate(true)
	check(not m.undo() and not m.remove_planned(0) and not m._cancel_field_compression(),"temporary compression cannot bypass insertion lock")
	check(JSON.stringify(m.s)==JSON.stringify(before),"blocked compression cancellation is atomic")
	check(m.reload_magazine() and m.s.discard==["bore","bore"] and m.s.field_compression.is_empty(),"full ejection consumes both originals exactly once")
	check(m.s.field_compression_left==charges-1,"full ejection does not refund compression charge")
	saved(m,"ejected compression")
	m=finite(["bore","bore"])
	check(m.field_compress("bore") and m.confirm() and m.fire(),"compressed shot fires")
	check(m.s.discard.count("bore")==2 and not m.s.hand.has("bore"),"temporary originals both used this combat")
	saved(m,"used compression")
	m.begin_encounter()
	check(m.s.discard.is_empty() and m.s.hand.size()+m.s.draw.size()==m.s.deck.size(),"next combat restores all ownership")
	for gun in Ammo.GUNS:
		m=finite(["charge_hot","precise","cool"],[],gun)
		m.s.heat=Ammo.heat_limit(m.s)-2
		var shots:=fire(m,["charge_hot","precise","cool"])
		check(m.s.discard.has("charge_hot") and not m.s.hand.has("charge_hot"),"overheat cannot recycle spent support "+gun)
		check(m.s.discard.has("cool"),"unfired committed tail is used "+gun)
		saved(m,"forced reload "+gun)
	# An empty reserve is a clear outcome, while lingering burn may still win.
	m=finite(["basic_p1"],[["wall",40,9,0,30]])
	m.s.draw.clear();m.s.discard=m.s.deck.duplicate();m.s.discard.erase("basic_p1")
	check(m.load_round("basic_p1"),"plan final ineffective shot")
	check(Forecast.compact_summary(Forecast.analyze(m.s,true)).contains("탄약 소진"),"forecast distinguishes empty ammo from collision")
	check(m.confirm() and m.fire(),"final ineffective shot")
	check(m.s.phase=="lost" and m.s.loss_reason=="ammo","ammunition exhaustion ends without softlock")
	saved(m,"exhaustion")
	m=finite(["bore"],[["wall",6,9,0,30]])
	m.s.draw.clear();m.s.discard=m.s.deck.duplicate();m.s.discard.erase("bore")
	fire(m,["bore"])
	check(m.s.phase=="ready","lingering fire can continue")
	check(m.reload_magazine() and m.s.phase=="plan","burn continues on empty reload")
	check(m.reload_magazine() and m.s.phase in ["reward","won"],"last burn can win with no ammo")
	saved(m,"burn victory")
	var old=fixture(["bore","cool"])
	old.s.draw.clear();old.s.discard=old.s.deck.duplicate()
	for id in old.s.hand:old.s.discard.erase(id)
	check(old.reload_magazine() and old.s.hand.size()==Ammo.hand_capacity(old.s),"legacy run still recycles")
	saved(old,"legacy")
	old=fixture(["bore","bore"])
	check(old.load_round("bore") and old.undo() and old.s.hand==["bore","bore"] and old.s.discard.is_empty(),"legacy recall unchanged")
	charges=old.s.field_compression_left
	check(old.field_compress("bore") and old.undo() and old.s.hand==["bore","bore"] and old.s.field_compression_left==charges,"legacy compression recall unchanged")
	saved(old,"legacy recall")
	var invalid=old.s.duplicate(true)
	invalid.reserve_version=2
	var target=Model.new()
	check(not target.restore_state(invalid) and target.s.is_empty(),"unknown policy rejects atomically")
	var opening_ids: Array=[]
	for seed_value in range(25):
		var c=Campaign.new()
		c.start("heavy",seed_value)
		c.model.s.deck.append_array(["bore","cool","charge"])
		c.model.begin_encounter()
		check(Ammo.source_id(c.model.s.hand[0])!="basic","an owned special arrives in opening hand")
		check(c.model.s.hand.size()+c.model.s.draw.size()==23,"opening promise creates no cards")
		opening_ids.append(c.model.s.hand[0])
		var same=c.model.s.hand.duplicate()
		c.model.begin_encounter()
		check(c.model.s.hand==same,"opening promise deterministic for same seed")
		saved(c.model,"earned opening")
	check(opening_ids.has("bore") and opening_ids.has("cool") and opening_ids.has("charge"),"opening special varies by seed")
	# Scatter's cached result also depends on remaining owned ammunition.
	m=finite(["basic_p1"],[["wall",40,9,0,30]],"scatter")
	m.s.draw.clear();m.s.discard=m.s.deck.duplicate();m.s.discard.erase("basic_p1")
	m.load_round("basic_p1")
	var no_ammo:=Forecast.analyze(m.s,true)
	m.s.draw.append(m.s.discard.pop_back())
	var with_ammo:=Forecast.analyze(m.s,true)
	check(no_ammo.lost_probability==1.0 and with_ammo.lost_probability==0.0,"scatter cache separates ammo exhaustion")
	var stocked=Campaign.new()
	stocked.start("burst",9182,0,"balanced",3,"carrier")
	for i in range(12):
		check(stocked.can_acquire_ammo("bore"),"stocking until cap legal")
		stocked._acquire_ammo("bore","")
	check(stocked.model.s.deck.size()==32 and not stocked.can_acquire_ammo("bore"),"inventory cap independent of hand")
	check(stocked.can_acquire_ammo("bore","basic_p1"),"replacement remains available at cap")
	check(stocked.save()==OK,"full reserve saves outside combat")
	var stocked_copy=Campaign.new()
	check(stocked_copy.restore() and stocked_copy.model.s.deck.size()==32,"full reserve restores")
	# Duplicate rounds remain committed; only their order can be edited freely.
	for gun in Ammo.GUNS:
		m=finite(["basic_p1","basic_p1","bore"],[],gun)
		for id in ["basic_p1","bore","basic_p1"]: check(m.load_round(id),"duplicate plan "+gun)
		var stable: Dictionary=m.s.duplicate(true)
		check(m.move_planned(0,1) and m.move_planned(1,0),"reorder stays legal")
		check(m.s.hand==stable.hand and m.s.discard==stable.discard,"reorder has no ammo penalty")
		var no_op:=JSON.stringify(m.s)
		check(not m.remove_planned(2) and not m.remove_planned(0) and not m.undo(),"duplicate copies cannot be recalled "+gun)
		check(JSON.stringify(m.s)==no_op,"blocked duplicate recall preserves all copies")
		check(not m.remove_planned(-1) and not m.remove_planned(9) and JSON.stringify(m.s)==no_op,"invalid recall is atomic")
		saved(m,"locked duplicate plan "+gun)
		check(m.confirm(),"confirm all inserted copies")
		saved(m,"duplicate commit "+gun)
	# A planning reload must not turn into a free cancellation path.
	m=finite(["bore","cool","basic_p1"])
	check(m.load_round("bore"),"plan reload round")
	before=m.s.duplicate(true)
	var expected:=Forecast.reload_now(m.s,true)
	check(JSON.stringify(m.s)==JSON.stringify(before),"reload preview does not spend live cards")
	var reload_turns: int=m.reload_cost()
	check(m.reload_magazine() and m.s.discard==["bore"] and not m.s.hand.has("bore") and m.s.hand.has("cool"),"planning reload consumes planned but keeps unplanned")
	check(m.s.turns==before.turns+reload_turns,"full ejection pays existing weapon reload turns")
	check(m.s.phase==expected.phase and m.s.enemies==expected.enemies,"planning reload forecast matches")
	saved(m,"planning reload")
	m=finite(["bore","bore","basic_p1"])
	check(m.field_compress("bore") and m.load_round("basic_p1"),"mixed temporary planning reload")
	check(m.reload_magazine() and m.s.discard.count("bore")==2 and m.s.discard.count("basic_p1")==1 and m.s.field_compression.is_empty(),"reload no temporary refund loophole")
	saved(m,"temporary planning reload")
	for temporary in [false,true]:
		m=finite(["precise","precise","basic_p1","basic_p2"] if temporary else ["precise_c","basic_p1","basic_p2"])
		check(m.load_round("basic_p1"),"anchor fixture tail")
		check(m.field_compress("precise") if temporary else m.load_round("precise_c"),"insert fixed first round")
		check(not m.can_load("basic_p2") and m.load_block_reason("basic_p2")=="첫 발 고정","blocked insertion does not advise impossible recall")
		check(not m.move_planned(0,1) and not m.remove_planned(0),"fixed first constraint cannot bypass insertion lock")
		saved(m,"anchored insertion")
		check(m.reload_magazine() and m.s.plan.is_empty() and m.can_load("basic_p2"),"full ejection clears anchored loadout without softlock")
		check(m.s.discard.count("precise")==2 if temporary else m.s.discard.count("precise_c")==1,"anchored originals spent correctly")
		saved(m,"anchored ejection")
	# Ejection of the last card can exhaust ammunition; active burn may still win.
	for burning in [false,true]:
		m=finite(["basic_p1"],[["wall",2,0,0,30]])
		m.s.draw.clear();m.s.discard=m.s.deck.duplicate();m.s.discard.erase("basic_p1")
		if burning: m.s.enemies[0].burn=1
		check(m.load_round("basic_p1") and not m.undo() and m.s.phase=="plan","final round remains locked until shot or reload")
		check(m.reload_magazine(),"eject final card")
		check(m.s.phase in ["won","reward"] if burning else m.s.phase=="lost" and m.s.loss_reason=="ammo","last ejection settles exhaustion or burn victory")
		saved(m,"last ejection")
	m.begin_encounter()
	check(m.s.discard.is_empty() and m.s.hand.size()+m.s.draw.size()==m.s.deck.size(),"next battle restores ejected cards")
	var ongoing=Campaign.new()
	ongoing.start("burst",731042)
	check(ongoing.enter(int(ongoing.choices()[0].id)),"real campaign combat")
	var loaded_id:=str(ongoing.model.s.hand[0])
	check(ongoing.model.load_round(loaded_id) and not ongoing.model.undo(),"real campaign unconfirmed lock")
	check(ongoing.save()==OK,"mid-plan locked campaign saves")
	var ongoing_copy=Campaign.new()
	check(ongoing_copy.restore() and ongoing_copy.model.s.plan==[loaded_id] and ongoing_copy.model.s.hand==ongoing.model.s.hand and ongoing_copy.model.s.discard.is_empty(),"mid-plan inserted round survives continue")
	check(not ongoing_copy.model.undo() and ongoing_copy.model.reload_magazine() and ongoing_copy.model.s.discard==[loaded_id],"continued plan remains locked and can be fully ejected")
	for finish_by_reload in [true,false]:
		var defeated=Campaign.new()
		defeated.start("single",731042)
		# This regression explicitly exercises the saved pre-emergency policy.
		defeated.s.erase("emergency_version")
		defeated.model.s.erase("emergency_version")
		defeated.model.s.erase("emergency_uses")
		defeated.enter(int(defeated.choices()[0].id))
		var last:=str(defeated.model.s.hand[0])
		defeated.model.s.hand=[last]
		defeated.model.s.draw=[]
		defeated.model.s.discard=defeated.model.s.deck.duplicate()
		defeated.model.s.discard.erase(last)
		check(defeated.model.load_round(last),"final campaign round")
		if finish_by_reload: check(defeated.model.reload_magazine(),"final campaign ejection")
		else: check(defeated.model.confirm() and defeated.model.fire(),"final campaign shot")
		defeated.sync_combat()
		check(defeated.s.phase=="lost" and defeated.model.s.loss_reason=="ammo","actual campaign exhaustion")
		var final_zones: Dictionary=defeated.model.s.duplicate(true)
		check(defeated.save()==OK and defeated.model.s==final_zones,"defeat save never refills exhausted ammunition")
		var resumed=Campaign.new()
		var restored_loss: bool=resumed.restore()
		check(restored_loss,"exhaustion campaign restores")
		if restored_loss:
			check(resumed.s.phase=="lost" and JSON.parse_string(JSON.stringify(resumed.model.s))==JSON.parse_string(JSON.stringify(final_zones)),"exhaustion save preserves full terminal state")
	var file=FileAccess.open(OS.get_environment("QA_OUTPUT_DIR").path_join("rules.json"),FileAccess.WRITE)
	file.store_string(JSON.stringify({"checks":checks,"failures":failures}));file.close()
	print("RESERVE RULES COMPLETE checks=%d failures=%d"%[checks,failures])
	quit(0 if failures==0 else 1)
