extends "res://tests/fire_control_ui.gd"
const Focus = preload("res://redesign/focus_build.gd")
func run() -> void:
	output = OS.get_environment("QA_OUTPUT_DIR")
	if not output.replace("\\","/").contains("/qa_runtime/focus_build_20261103/"): quit(2); return
	Input.emulate_mouse_from_touch = true
	var base_mode: int = root.content_scale_mode
	var base_size: Vector2i = root.content_scale_size
	if FileAccess.file_exists(Campaign.SAVE): DirAccess.remove_absolute(Campaign.SAVE)
	host = load("res://redesign/main.tscn").instantiate();root.add_child(host);await settle()
	host.preparation_seed = "731042";host._open_preparation();await settle();await tap("start_single")
	check(Focus.enabled(host.campaign.s),"real new-run button enables focus rules")
	host._campaign_action("departure_skip");await settle();host._campaign_action("enter",101);await settle()
	host.campaign_hud.hud.feedback.save_setting("motion","fast")
	var solver = preload("res://tests/fire_control_solver.gd").new()
	var path: Array = solver.solve(host.model,4,18)
	check(not path.is_empty(),"real starting battle has a legal route")
	for step in path:
		if step.action == "fire":host.campaign_hud.select_budget(int(step.get("rounds",0)) if int(step.get("rounds",0)) > 0 else host.campaign_hud.maximum_budget())
		if step.action == "eject":
			for i in step.indices: await tap("Select%d" % int(i))
			await tap("EjectToggle")
		else: await tap({"fire":"Fire","cool":"Cool","reload":"Reload","emergency":"Reload"}[step.action])
	check(host.campaign.engine_reward(),"actual combat reaches core reward")
	await capture("earned_core_1280x800")
	await tap("city_reward_siege_drive")
	await tap("Confirm")
	check(host.campaign.first_ammo_reward(),"core selection exposes starter package")
	var choice_state: Dictionary = canonical({"campaign":host.campaign.s,"combat":host.model.s,"profile":host.campaign.profile})
	for size in [Vector2i(740,360),Vector2i(844,390),Vector2i(1280,800)]:
		root.size = size;host.redraw();await settle()
		var card: Control = host.find_child("city_reward_pierce_p2",true,false)
		check(card != null and card.is_visible_in_tree(),"package choice exists at each viewport")
		check(card.get_node("Quantity").text == "×2","package face discloses two main rounds")
		if size.x < 1120:
			check(root.content_scale_mode == Window.CONTENT_SCALE_MODE_DISABLED,"small reward uses native readable pixels")
			check(card.get_global_transform_with_canvas().get_scale().x >= 0.99,"new reward cards are not shrunk with full-screen viewport")
		await capture("package_%dx%d" % [size.x,size.y])
		if size.x < 1120:
			host.main_scroll.ensure_control_visible(card.get_parent());await settle()
			await capture("package_cards_%dx%d" % [size.x,size.y])
	root.size = Vector2i(844,390);host.redraw();await settle()
	var initial_size: int = host.model.s.deck.size()
	await tap("city_reward_pierce_p2")
	await tap("Confirm")
	check(host.campaign.s.phase == "map" and host.model.s.deck.count("pierce_p2") == 2 and host.model.s.deck.count("charge") == 1,"confirmation grants exact package")
	check(host.model.s.deck.size() == initial_size,"starter package preserves total ammo")
	check(root.content_scale_mode == Window.CONTENT_SCALE_MODE_DISABLED and root.content_scale_factor == preload("res://redesign/ui_readability.gd").scale_for(root.size),"reward exit keeps readable map scaling")
	var saved = Campaign.new();check(saved.restore(),"package choice is saved automatically")
	check(canonical(saved.model.s) == canonical(host.model.s),"package save restores exact deck and RNG")
	FileAccess.open(output.path_join("after_package.json"),FileAccess.WRITE).store_string(JSON.stringify({"campaign":saved.s,"combat":saved.model.s,"profile":saved.profile},"  "))
	var initial = Campaign.new();check(initial.restore_state(choice_state),"package choice checkpoint restores")
	check(initial.reward("vent") and initial.model.s.deck.count("vent") == 2 and initial.model.s.deck.has("charge_heat"),"alternate starter uses matching support")
	root.size = Vector2i(740,360)
	var last_choice = Campaign.new();check(last_choice.restore_state(choice_state),"third package available for touch test")
	await mount(last_choice);await tap("city_reward_vent");await tap("Confirm")
	check(last_choice.s.phase == "map" and last_choice.model.s.deck.count("vent") == 2,"small-screen scroll reaches and selects third package")
	root.size = Vector2i(844,390)
	# Earned post-shop state, generated by the real whole-climb runner.
	var report_path := ProjectSettings.globalize_path("res://../qa_runtime/focus_build_20261103/climb_primary/balance.json")
	var report: Dictionary = JSON.parse_string(FileAccess.get_file_as_string(report_path))
	var chosen: Dictionary = {}
	for battle in report.battles:
		if battle.gun == "single" and battle.parts.has("third_striker"):chosen = battle;break
	check(not chosen.is_empty(),"new positional part was actually acquired in campaign")
	if not chosen.is_empty():
		var file := report_path.get_base_dir().path_join("combat_single_731042_r%d_n%d.json" % [int(chosen.region),int(chosen.node)])
		var c = Campaign.new();check(c.restore_state(JSON.parse_string(FileAccess.get_file_as_string(file))),"earned equipped campaign restores")
		await mount(c);hud_bounds();await capture("earned_parts_844x390")
		await tap("Parts");await capture("parts_detail_844x390");await tap("CloseDetail")
		# A clear controlled illustration shares the live HUD and real resolver.
		# It is marked separately from acquired state and never saved as user progress.
		c.model.s.deck = ["basic_p2","charge","basic_p2","pierce_p2","basic_p2","basic_p2","basic_p2","basic_p2"]
		c.model.s.equipped_parts = ["siege_drive","third_striker"]
		c.s.equipped_parts = c.model.s.equipped_parts.duplicate();c.s.parts = c.s.equipped_parts.duplicate()
		c.model.begin_encounter();c.model.s.magazine = ["basic_p2","charge","basic_p2","pierce_p2"]
		c.model.s.magazine_loaded = c.model.s.magazine.duplicate();c.model.s.hand = [];c.model.s.draw = ["basic_p2","basic_p2","basic_p2","basic_p2"]
		c.model.s.phase = "ready";c.model.s.magazine_ejected = 0
		c.model.s.enemies[0].hp = 400;c.model.s.enemies[0].max_hp = 400;c.model.s.enemies[0].distance = 80
		c.model._record("load",{"load_order":c.model.s.magazine.duplicate(),"whole_magazine":true})
		await mount(c);await tap("Select2");await tap("EjectToggle")
		check(c.model.s.magazine == ["basic_p2","charge","pierce_p2"],"live ejection aligns the main round as third")
		check(host.campaign_hud.combo_label.text.contains("3번째 철갑탄 ×3"),"HUD explains the aligned payoff")
		await capture("aligned_844x390")
		await drag_one();await tap("Fire");await tap("Fire")
		check(c.model._recent_part_rounds().size() == 2,"two partial fire inputs retain ordinal")
		await capture("third_ready_844x390");await tap("Fire")
		var result: Dictionary = c.model.s.history.back().detail.results[0]
		check(result.part_factor == 3 and result.magazine_ordinal == 3,"live third shot uses actual positional multiplier")
		check(preload("res://redesign/damage_readout.gd").entry(result).label.contains("3번째"),"resolved damage identifies positional cause")
		FileAccess.open(output.path_join("payoff.json"),FileAccess.WRITE).store_string(JSON.stringify(result,"  "))
	if is_instance_valid(host):host.free();await settle()
	FileAccess.open(output.path_join("result.json"),FileAccess.WRITE).store_string(JSON.stringify({"checks":checks,"failures":failures},"  "))
	print("FOCUS BUILD COMPLETE checks=%d failures=%d" % [checks,failures.size()]);quit(0 if failures.is_empty() else 1)
