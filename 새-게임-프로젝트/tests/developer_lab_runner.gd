extends "res://tests/frontend_ui_runner.gd"
const Lab = preload("res://redesign/dev_build_lab.gd")
const Data = preload("res://redesign/content.gd")

func _rules() -> void:
	var lab = Lab.new()
	check(lab.add_round("precise").is_empty(), "load first round")
	check(lab.add_round("charge").is_empty(), "load booster last")
	check(lab.fixture().s.plan == ["charge", "precise"], "LIFO follows real model")
	var original: Dictionary = lab.fixture().s.duplicate(true)
	var a: Dictionary = lab.run_trial()
	var b: Dictionary = lab.run_trial()
	check(a == b, "same seed reproduces complete trial")
	check(lab.fixture().s == original, "forecast and trial never mutate preparation")
	check(a.forecast.enemies == a.after.enemies, "deterministic forecast matches actual fire")
	lab.loaded.clear()
	check(not lab.add_round("pierce_f").is_empty(), "temporary compression cannot be freely inserted")
	check(lab.add_round("pierce_c").is_empty(), "two slot compressed round accepted")
	check(Data.slots_used(lab.fixture().s.plan) == 2, "compressed slot cost retained")
	lab.loaded.clear()
	for i in range(4): lab.add_round("basic")
	check(not lab.add_round("basic").is_empty() and lab.loaded.size() == 4, "overcapacity rejects without mutation")
	var parts_before: Array = lab.parts.duplicate()
	check(not lab.toggle_part("field_press").is_empty() and lab.parts == parts_before, "capacity penalty preserves valid existing magazine")
	lab.loaded.clear()
	check(lab.toggle_part("field_press").is_empty(), "core may be equipped after unloading")
	check(not lab.toggle_part("overbore").is_empty(), "second core rejected")
	lab.parts.clear()
	for id in ["lens", "supply", "coil", "capacitor", "rammer"]: check(lab.toggle_part(id).is_empty(), "module accepted: " + id)
	check(not lab.toggle_part("sequencer").is_empty(), "sixth part rejected")
	check(lab.toggle_part("coil").is_empty() and not lab.parts.has("coil"), "part removal works")
	check(not lab.toggle_part("loader").is_empty(), "incompatible part rejected")
	check(Lab.catalog(0, "철갑").has("pierce"), "catalog filters localized name")
	check(Lab.catalog(1, "cooling").has("cooling_breech"), "catalog filters internal id")
	check(Lab.catalog(0, "no-such-ammo-xyz").is_empty(), "empty search supported")
	check(not lab.configure("single", 999, 42, 0).is_empty(), "out of range fixture rejected")
	for gun in Data.GUNS:
		lab = Lab.new()
		check(lab.configure(gun, 3, 42, 9).is_empty(), "gun setup: " + gun)
		lab.add_round("precise"); lab.add_round("charge")
		var r: Dictionary = lab.run_trial()
		check(not r.is_empty() and r.peak >= 9, "real resolver with starting heat: " + gun)
		check(r == lab.run_trial(), "seeded trial reproducible: " + gun)
		if gun != "scatter":
			check(r.forecast.enemies == r.after.enemies and r.forecast.heat.peak_max == r.peak, "forecast parity: " + gun)
		else:
			check(r.peak >= r.forecast.heat.peak_min and r.peak <= r.forecast.heat.peak_max, "scatter actual within forecast heat range")

func _run() -> void:
	if not ProjectSettings.globalize_path("user://").replace("\\", "/").contains("/qa_runtime/developer_lab/"):
		quit(1); return
	output = OS.get_environment("QA_OUTPUT_DIR")
	DirAccess.make_dir_recursive_absolute(output)
	_rules()
	root.size = Vector2i(1280,800)
	var scene_preview: Control = load("res://redesign/developer_lab.tscn").instantiate()
	scene_preview.set_script(null)
	root.add_child(scene_preview)
	await settle()
	check(scene_preview.find_child("Trial").is_visible_in_tree(), "serialized composition before runtime binding")
	check(root.get_texture().get_image().save_png(output.path_join("scene_before_ready.png")) == OK, "editor composition capture")
	scene_preview.free()
	for resolution in [Vector2i(1008,630), Vector2i(1280,800), Vector2i(1600,720)]:
		root.size = resolution
		screen = load("res://redesign/main.tscn").instantiate()
		screen.save_enabled = false
		root.add_child(screen)
		await settle()
		var original: Dictionary = screen.model.s.duplicate(true)
		screen._developer()
		await settle()
		await click("debug_lab")
		var ui = screen.workspace_overlay
		check(ui != null and ui.name == "DeveloperLab", "developer menu enters lab")
		ui.lab.add_round("precise"); ui.lab.add_round("charge")
		ui._changed()
		ui.get_node("%Trial").pressed.emit()
		ui.get_node("%Pin").pressed.emit()
		check(not ui.pinned.is_empty(), "comparison result pinned")
		ui.lab.toggle_part("sequencer")
		ui._changed()
		check(ui.last_result.is_empty() and ui.get_node("%Pin").disabled, "changes invalidate stale trial")
		ui.get_node("%Trial").pressed.emit()
		check(ui.get_node("%Result").text.contains("변화"), "same conditions show comparison delta")
		await capture("lab_%d" % resolution.x)
		for key in ["Close", "Gun", "Search", "Catalog", "Card", "Add", "Trial", "Pin", "Notice"]:
			var control: Control = ui.get_node("%" + key)
			check(Rect2(Vector2.ZERO,screen.size).encloses(control.get_global_rect()), "bounds %s %d" % [key,resolution.x])
		ui.get_node("%Seed").value = 43
		ui.get_node("%Trial").pressed.emit()
		check(ui.get_node("%Result").text.contains("달라 직접 비교"), "changed fixture warns instead of misleading delta")
		ui.get_node("%Search").text = "no-such-ammo-xyz"
		ui.get_node("%Search").text_changed.emit("no-such-ammo-xyz")
		check(ui.get_node("%Catalog").item_count == 0 and ui.get_node("%Add").disabled, "empty catalog disables action")
		ui.get_node("%Search").text = ""
		ui.get_node("%Kind").select(1)
		ui._catalog()
		ui.selected_id = "field_press"
		ui._detail()
		await capture("parts_%d" % resolution.x)
		ui.lab.loaded.clear()
		ui.lab.parts = ["lens", "supply", "coil", "capacitor", "rammer"]
		ui.lab.configure("scatter",3,42,0)
		for i in range(6): ui.lab.add_round("basic")
		ui._sync_settings(); ui._changed()
		await settle()
		check(Rect2(Vector2.ZERO,screen.size).encloses(ui.get_node("%Notice").get_global_rect()), "five parts six rounds fit")
		await capture("full_build_%d" % resolution.x)
		ui.get_node("%UITab").pressed.emit()
		await settle()
		await capture("gallery_%d" % resolution.x)
		var actual_button: Button = ui.get_node("%Interactive")
		actual_button.grab_focus()
		var key := InputEventKey.new()
		key.keycode = KEY_ENTER; key.pressed = true
		root.push_input(key)
		key = InputEventKey.new()
		key.keycode = KEY_ENTER; key.pressed = false
		root.push_input(key)
		await settle()
		check(ui.get_node("%InputStatus").text.contains("확인"), "real keyboard activation")
		key = InputEventKey.new()
		key.keycode = KEY_ESCAPE; key.pressed = true
		root.push_input(key)
		await settle()
		check(screen.workspace_overlay == null, "Esc closes lab")
		check(screen.model.s == original, "main model preserved")
		screen.free()
	print("DEVELOPER LAB COMPLETE checks=%d failures=%d" % [checks,failures.size()])
	quit(0 if failures.is_empty() else 1)
