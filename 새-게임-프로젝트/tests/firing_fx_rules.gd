extends "res://tests/focus_build_rules.gd"
const FX=preload("res://redesign/firing_vfx.gd")
const Style=preload("res://redesign/impact_style.gd")

func run() -> void:
	output=OS.get_environment("QA_OUTPUT_DIR")
	if not output.replace("\\","/").contains("/qa_runtime/firing_fx_20261106/"):quit(2);return
	var shapes:Array=[]
	for gun in FX.GUNS:
		var m=fixture(["basic_p2","precise_p2"],["opening"],gun)
		var packet:=shot(m)
		var before:=JSON.stringify(packet)
		var fx:=FX.profile(gun,packet)
		check(JSON.stringify(packet)==before,"launch styling is read-only "+gun)
		check(fx.color==Style.resolve(packet).color,"same actual effect hue at muzzle and impact "+gun)
		shapes.append([fx.index,fx.length,fx.width])
		for origin in [Vector2(200,190),Vector2(200,240)]:
			for target in [Vector2(205,190),Vector2(900,220),origin]:
				for progress in [0.0,0.01,0.1,0.5,1.0]:
					for reduced in [false,true]:
						var line:=FX.geometry(origin,target,progress,fx,reduced)
						check(line.length<=origin.distance_to(line.head)+0.001,"tail never extends behind muzzle "+gun)
						check((line.tail-origin).dot(line.direction)>=-0.001,"tail remains on travelled path "+gun)
						if progress==1.0:check(line.head.is_equal_approx(target),"endpoint is real target "+gun)
		var block:=packet.duplicate(true);block.damage=0;block.intercept=true
		check(FX.profile(gun,block).color==fx.color,"blocked/intercepted launch keeps applied hue "+gun)
		check(not Style.resolve(block).active,"blocked/intercepted impact remains suppressed "+gun)
		var support:=FX.profile(gun,{"id":"charge_hot","damage":0,"boost_factor_granted":9,"overdrive":true})
		check(not support.attack and support.rank==0 and not support.overdrive,"support never impersonates an attack or overdrive "+gun)
	check(shapes.size()==5 and shapes[0]!=shapes[1] and shapes[1]!=shapes[2] and shapes[3]!=shapes[4],"five gun profiles distinguish silhouette and carrier")
	var heavy=fixture(["basic","basic","basic","basic","basic"],[],"heavy")
	heavy.s.heat=Content.heat_limit(heavy.s)-1
	heavy.s.fire_heat_trial.rounds=5
	check(heavy.fire(),"real reactor boundary fires")
	var packets:Array=heavy.s.history.back().detail.results
	check(packets.any(func(r):return r.overdrive),"actual reactor overdrive generated by resolver")
	for packet in packets:check(FX.profile("heavy",packet).overdrive==bool(packet.overdrive),"extra collar gas only on actual overdrive")
	var image:=FX.ATLAS.get_image()
	check(image.get_size()==Vector2i(480,384),"one compact atlas")
	var hashes:Array=[]
	for gun_index in range(5):
		var pixels:=0;var signature:=""
		for local_frame in range(6):
			var index:=gun_index*6+local_frame
			var cell:=image.get_region(Rect2i(index%5*96,index/5*64,96,64))
			var count:=0
			for y in range(64):
				for x in range(96):
					if cell.get_pixel(x,y).a>0:count+=1
			if local_frame==0:signature=cell.get_data().hex_encode().sha256_text();pixels=count
			if local_frame==1:check(count==pixels,"one peak, no repeated pulse")
			if local_frame in [2,3]:check(count>0 and count<pixels,"flash contracts before disappearing")
			if local_frame>=4:check(count==0,"blank terminal frames prevent lingering flash")
		check(pixels>10 and not hashes.has(signature),"each gun has unique nonblank muzzle silhouette")
		hashes.append(signature)
	FileAccess.open(output.path_join("result.json"),FileAccess.WRITE).store_string(JSON.stringify({"checks":checks,"failures":failures,"profiles":shapes,"overdrive_packets":packets},"  "))
	print("FIRING FX RULES COMPLETE checks=%d failures=%d"%[checks,failures.size()]);quit(0 if failures.is_empty() else 1)
