extends RefCounted
## 선택형 심화 기록. 전투 규칙이나 필수 정보를 수집 뒤로 숨기지 않는다.

const FRAGMENTS := [
	{"title": "배급표", "text": "신체 항목에는 '생체'라고 적혀 있다. 교체 이력 칸은 비어 있다. 빈칸에는 도장이 필요하지 않았다."},
	{"title": "아래의 창", "text": "창은 맞은편 건물의 기초를 향해 나 있다. 해가 뜨는 시간은 위층의 조명이 꺼지는 시간으로 안다."},
	{"title": "중고 목록", "text": "인간용 화기 한 정. 내장 연산 없음. 외부 탄도 장치 포함. 판매자는 작동 여부보다 아직 쓸 사람이 있다는 사실을 의아해했다."},
	{"title": "순환 장치", "text": "표준 장약은 회수해서 다시 만든다. 특수 장약에는 같은 표시가 없다. 설명서 마지막 줄에 제조 공정 종료라고 적혀 있다."},
	{"title": "승강기", "text": "문은 고장 나지 않았다. 신체 인증 규격이 맞지 않을 뿐이다. 계단 표지판에는 인증 장치가 없다."},
	{"title": "공역 근무표", "text": "야간 수당은 삭제되었다. 광학 교체를 마친 작업자에게는 야간이라는 구분이 적용되지 않는다."},
	{"title": "배송 주소", "text": "소포에는 층수와 부품 번호만 있다. 수취인의 이름은 결제 정보에 남아 있을 것이다."},
	{"title": "안전 공지", "text": "작업 중 팔다리를 교체할 때에는 해당 관절의 전원을 차단할 것. 작업을 멈추라는 문장은 없다."},
	{"title": "빈 신발장", "text": "정비 구역 입구에 신발장이 남아 있다. 가장 아래 칸에도 먼지가 고르게 쌓여 있다."},
	{"title": "구형 규격", "text": "연산 장치가 탄도를 표시한다. 손은 표시된 순서대로 탄을 넣는다. 이 장비에서 아직 교체되지 않은 것은 손이다."},
	{"title": "재동기화", "text": "실행 큐를 강제로 꺼내면 장치가 잠시 멈춘다. 설명서는 그 시간을 고장으로 분류하지 않는다."},
	{"title": "보관료", "text": "적출 조직 보관 계약이 갱신되었다. 소유자는 이미 서른두 해 동안 보관함을 열지 않았다."},
	{"title": "관리층 민원", "text": "아래에서 올라오는 소음에 대한 민원. 답변에는 차음재의 두께와 공사 비용이 적혀 있다. 소음의 원인은 기재되지 않았다."},
	{"title": "주민 수", "text": "거주자 수는 그대로인데 생체 유지 설비의 사용량은 해마다 줄고 있다. 통계에는 개선이라고 표시된다."},
	{"title": "방문 규정", "text": "생체 방문자는 별도 공기 공급이 필요하다. 오랫동안 사용하지 않은 서식이라 담당자의 이름이 지워져 있다."},
	{"title": "회수 목록", "text": "폐기품의 목적지는 최하층으로 지정되어 있다. 화기 한 정의 일련번호를 알아볼 수 있다. 지금 손에 든 것과 같다."},
	{"title": "정점의 복도", "text": "먼지도 발자국도 없다. 바닥은 지나갈 때마다 닦인다. 이곳에서 오래된 흔적은 장비 안에만 남는다."},
	{"title": "도달자 서식", "text": "이름과 출생층을 적는 칸이 있다. 다음 장부터는 교체할 부위의 목록이다. 귀환 주소를 적는 칸은 없다."},
	{"title": "이전 기록", "text": "마지막 생체 도달자의 기록은 사십일 년 전이다. 서명 아래에는 작은 숫자들이 있다. 화기 등록 번호다."},
	{"title": "서명란", "text": "승인 도장은 이미 찍혀 있다. 마지막 칸만 비어 있다. 장치는 손을 기다린다."},
]

static func entry(fragment_id: int) -> Dictionary:
	return FRAGMENTS[fragment_id - 1].duplicate() if fragment_id >= 1 and fragment_id <= FRAGMENTS.size() else {}

static func collected_text(collected: Array[int]) -> String:
	var lines := PackedStringArray()
	for index in range(FRAGMENTS.size()):
		if collected.has(index + 1):
			lines.append("[b]%02d · %s[/b]\n%s" % [index + 1, FRAGMENTS[index].title, FRAGMENTS[index].text])
		else:
			lines.append("[color=#777788]%02d · 아직 복원하지 않은 기록[/color]" % [index + 1])
	return "\n\n".join(lines)
