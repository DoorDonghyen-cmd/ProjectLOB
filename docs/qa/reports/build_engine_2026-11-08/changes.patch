+			for offer in Data.offers(node, 731042 + k, 0, "single", ["volley_drive"], [], [], ["volley_drive"], 3, 1, old_state):
+				if offer.type == "part" and BuildEngine.NEW_PARTS.has(offer.id): seen_old += 1
